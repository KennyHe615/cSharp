{
    "version": "2.0",
    "logging": {
        "logLevel": {
            "default": "Information",
            "Function": "Debug",
            "Host.Startup": "Error",
            "Host.General": "Error",
            "Host": "Error",
            "Worker": "Warning",
            "Workers": "Warning",
            "Microsoft.Azure.Functions.Worker": "Warning",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Warning",
            "Microsoft.AspNetCore": "Warning"
        },
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": false,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        },
        "console": {
            "isEnabled": true,
            "includeScopes": true
        }
    },
    "functionTimeout": "01:00:00"
}
