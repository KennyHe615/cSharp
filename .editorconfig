root = true
# top-most EditorConfig file

############################################################
# All files
############################################################
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[**/*.cs]
# Keep usings grouped and stable across tooling
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_style_expression_bodied_methods = false

# Prefer file-scoped namespaces (C# 10+); set to suggestion to avoid breaking builds in older projects
csharp_style_namespace_declarations = file_scoped:suggestion

# "var" policy (common enterprise default: explicit types)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Braces/newlines (stable, widely accepted)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ReSharper properties
resharper_csharp_max_line_length = 120
resharper_keep_existing_attribute_arrangement = false
resharper_wrap_chained_method_calls = chop_always


############################################################
# DTOs, Mapper Profiles and Entities - Suppress ReSharper warnings
############################################################
[{**/*Options.cs,**/*Response.cs,**/*Profile.cs,**/Entities/**/*.cs,**/DTOs/**/*.cs,**/*RawContract.cs}]
resharper_class_never_instantiated_global_highlighting = none
resharper_unused_type_global_highlighting = none
resharper_unused_member_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none
resharper_auto_property_can_be_made_get_only_global_highlighting = none
resharper_property_can_be_made_init_only_global_highlighting = none
resharper_collection_never_updated_global_highlighting = none